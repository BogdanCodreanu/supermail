{
  "name": "supermail",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "dev:mock": "npm run dev:mock -w web",
    "test": "npm test --workspaces --if-present",
    "typecheck": "tsc -b",
    "build": "npm run build -w web && npm run build -w server"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
