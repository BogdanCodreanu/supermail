{
  "name": "@supermail/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -b && node -e \"require('fs').cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "dev": "tsx watch --conditions=development src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/static": "10.1.8",
    "@supermail/shared": "0.1.0",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.7",
    "google-auth-library": "11.3.2",
    "googleapis": "188.0.0",
    "nodemailer": "10.3.0",
    "pino": "10.4.0",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/nodemailer": "8.0.2",
    "@types/web-push": "3.6.4",
    "tsx": "4.23.15",
    "vitest": "4.1.12"
  }
}
