# Copy to deploy/deploy.env (gitignored) and fill in your own values.
# deploy.sh, render.sh and verify.sh read it; nothing in it is ever committed.

# The Home Assistant host, as an ssh destination (an alias from ~/.ssh/config, or root@host).
# Its SSH add-on must give a shell with the `ha` CLI.
DEPLOY_HOST=homeassistant

# The Google OAuth client JSON on this machine (docs/google-cloud-setup.md). Copied file-to-file, never printed.
SUPERMAIL_CLIENT_FILE=$HOME/.config/supermail/client_secret.json

# The Gmail address allowed to sign in first (the add-on's owner_email option). deploy.sh sets it, and public_url, on
# every deploy, because an update can reset the add-on's options to their empty defaults.
SUPERMAIL_OWNER_EMAIL=you@example.com

# The public name SuperMail is served at. Its https:// form must equal the add-on's public_url option.
SUPERMAIL_DOMAIN=mail.example.com

# The port SuperMail listens on at 127.0.0.1 (the add-on's port option).
SUPERMAIL_PORT=8787

# DNS (render.sh): SUPERMAIL_DOMAIN becomes a CNAME to this name, for example your dynamic DNS name.
DNS_TARGET=your-ddns-name.example.net
# Route 53 only: the AWS CLI profile and the hosted zone that holds SUPERMAIL_DOMAIN.
AWS_PROFILE=default
ROUTE53_ZONE_NAME=example.com

# Reverse proxy (render.sh): leave empty for a normal Caddy that gets certificates over ports 80/443.
# Set it when only 443 reaches Caddy, forwarded to another port inside: Caddy then proves the domain with
# TLS-ALPN on that port and skips the HTTP challenge.
CADDY_TLS_ALPN_PORT=
